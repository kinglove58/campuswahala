ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS dependencies
WORKDIR /repo
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/* && npm install --global pnpm@10.32.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/game/package.json apps/game/package.json
COPY apps/marketing/package.json apps/marketing/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/campus-content/package.json packages/campus-content/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/game-engine/package.json packages/game-engine/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/payments/package.json packages/payments/package.json
COPY packages/security/package.json packages/security/package.json
COPY packages/testing/package.json packages/testing/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,id=cw-pnpm-api,target=/pnpm/store pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile

FROM dependencies AS build
COPY . .
RUN pnpm db:generate && pnpm exec turbo build --filter=@campuswahala/api
RUN --mount=type=cache,id=cw-pnpm-api,target=/pnpm/store pnpm --filter @campuswahala/api deploy --legacy --prod /output
# pnpm deploy does not carry Prisma's generated .prisma sibling by itself.
RUN node -e "const fs=require('node:fs'),p=require('node:path'); const src=p.dirname(require.resolve('@prisma/client/package.json',{paths:['/repo/packages/database']})); const db=fs.realpathSync('/output/node_modules/@campuswahala/database'); const dst=p.dirname(require.resolve('@prisma/client/package.json',{paths:[db]})); fs.cpSync(p.resolve(src,'../../.prisma/client'),p.resolve(dst,'../../.prisma/client'),{recursive:true});"

FROM ${NODE_IMAGE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production APP_ENV=production API_PORT=4000
WORKDIR /app
COPY --from=build --chown=node:node /output/ ./
# Prisma's optional build-tool peers are unnecessary after client generation.
# Remove them only inside this isolated image; the generated runtime stays intact.
RUN node -e "const fs=require('node:fs'),p=require('node:path'),root='/app/node_modules/.pnpm'; for(const name of fs.readdirSync(root)) if(name.startsWith('typescript@')||name.startsWith('prisma@')) fs.rmSync(p.join(root,name),{recursive:true,force:true});"
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:4000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
