generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model GuestPlayer {
  id String @id @db.Uuid
  campusId String @db.VarChar(20)
  programmeId String @db.VarChar(60)
  level Int
  durationYears Int
  avatar String @db.VarChar(20)
  nickname String @db.VarChar(40)
  tokenHash String @unique @db.Char(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
  @@index([expiresAt, id], map: "GuestPlayer_expiry_id_idx")
  @@index([campusId, programmeId, level])
}
