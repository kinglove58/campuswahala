{
  "name": "campuswahala",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tests.json",
    "test": "turbo build --filter=./packages/* && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @campuswahala/database generate",
    "db:migrate": "pnpm --filter @campuswahala/database migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "typescript": "5.9.3",
    "turbo": "2.11.7",
    "vitest": "5.0.3",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "prettier": "3.8.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
