FROM node:22-alpine AS build
WORKDIR /repo
RUN npm install --global pnpm@10.32.1
COPY . .
ARG APP=marketing
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_GAME_URL=http://localhost:3001
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_GAME_URL=$NEXT_PUBLIC_GAME_URL NEXT_TELEMETRY_DISABLED=1
RUN pnpm install --frozen-lockfile && pnpm exec turbo build --filter=@campuswahala/${APP}
RUN mkdir -p /output && cp -r apps/${APP}/.next/standalone/. /output/ && mkdir -p /output/apps/${APP}/.next/static && cp -r apps/${APP}/.next/static/. /output/apps/${APP}/.next/static/

FROM node:22-alpine AS runtime
ARG APP=marketing
ENV NODE_ENV=production APP_ENV=production HOSTNAME=0.0.0.0 PORT=3000 APP=$APP
WORKDIR /app
COPY --from=build --chown=node:node /output/ ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:3000').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node apps/$APP/server.js"]
